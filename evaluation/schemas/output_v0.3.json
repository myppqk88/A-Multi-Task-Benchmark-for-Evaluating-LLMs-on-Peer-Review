{
 "version": "0.3-draft",
 "status": "v0.3 (2026-10-24): T1 adds contribution_assessment (测量框架 §3.2). C1–C3 are scored against the card; external_novelty (C4) is scored only in the C4 source subset. Not yet applied to any input.json.",
 "issue_types": {
  "V1": "构念与测量效度",
  "V2": "内部效度与因果推断",
  "V3": "统计结论效度",
  "V4": "外部效度与推广",
  "V5": "质性研究可信度",
  "V6": "理论与论证",
  "V7": "报告透明与可复现",
  "V8": "结论与证据相称",
  "V9": "非实质性（语言/格式/体例）"
 },
 "L0_checks": {
  "exact_quote": "after normalising whitespace and quote marks, must occur verbatim in the model-visible field named by input_field, either as is or with standalone manuscript line-number lines removed",
  "page_images": "page must be one of the page images supplied to the model; observation is not string-checked",
  "schema": "output must validate against the task schema; enum values must be legal"
 },
 "schemas": {
  "T1": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "title": "T1_review_v0.3",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "summary",
    "issues",
    "contribution_assessment",
    "overall_assessment"
   ],
   "properties": {
    "summary": {
     "type": "string",
     "description": "<=150 words: the manuscript's central claims and overall appraisal"
    },
    "issues": {
     "type": "array",
     "minItems": 0,
     "maxItems": 5,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "claim",
       "issue_type",
       "status",
       "severity",
       "evidence",
       "reasoning"
      ],
      "properties": {
       "claim": {
        "type": "string"
       },
       "issue_type": {
        "enum": [
         "V1",
         "V2",
         "V3",
         "V4",
         "V5",
         "V6",
         "V7",
         "V8",
         "V9"
        ]
       },
       "status": {
        "enum": [
         "confirmed_error",
         "missing_information",
         "suggestion"
        ]
       },
       "severity": {
        "enum": [
         "major",
         "minor"
        ]
       },
       "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
         "oneOf": [
          {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "input_field",
            "exact_quote",
            "location_hint"
           ],
           "properties": {
            "input_field": {
             "type": "string"
            },
            "exact_quote": {
             "type": "string",
             "minLength": 1
            },
            "location_hint": {
             "type": "string"
            }
           }
          },
          {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "input_field",
            "page",
            "observation"
           ],
           "properties": {
            "input_field": {
             "const": "page_images"
            },
            "page": {
             "type": "integer",
             "minimum": 1
            },
            "observation": {
             "type": "string",
             "minLength": 1
            }
           }
          }
         ]
        }
       },
       "reasoning": {
        "type": "string",
        "description": "why this is a problem and which conclusion it affects"
       }
      }
     }
    },
    "contribution_assessment": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "claimed_contribution",
      "claim_support",
      "proportionality",
      "evidence",
      "reasoning",
      "external_novelty"
     ],
     "properties": {
      "claimed_contribution": {
       "type": "string",
       "description": "<=80 words: what the manuscript itself claims is new or contributed (C1)"
      },
      "claim_support": {
       "enum": [
        "supported",
        "partly_supported",
        "unsupported",
        "insufficient_evidence"
       ],
       "description": "C2: are the novelty/gap claims (e.g. \"first study\", \"fills a gap\") consistent with the literature the manuscript itself cites and the work it reports?"
      },
      "proportionality": {
       "enum": [
        "proportionate",
        "overstated",
        "understated"
       ],
       "description": "C3: is the claimed contribution in proportion to the design and evidence? (V8 covers individual conclusions; this covers the paper-level contribution)"
      },
      "evidence": {
       "type": "array",
       "minItems": 1,
       "items": {
        "oneOf": [
         {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "input_field",
           "exact_quote",
           "location_hint"
          ],
          "properties": {
           "input_field": {
            "type": "string"
           },
           "exact_quote": {
            "type": "string",
            "minLength": 1
           },
           "location_hint": {
            "type": "string"
           }
          }
         },
         {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "input_field",
           "page",
           "observation"
          ],
          "properties": {
           "input_field": {
            "const": "page_images"
           },
           "page": {
            "type": "integer",
            "minimum": 1
           },
           "observation": {
            "type": "string",
            "minLength": 1
           }
          }
         }
        ]
       }
      },
      "reasoning": {
       "type": "string",
       "description": "<=120 words"
      },
      "external_novelty": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "rating",
        "basis",
        "confidence"
       ],
       "properties": {
        "rating": {
         "enum": [
          1,
          2,
          3,
          4
         ],
         "description": "C4: 1 = little beyond existing work; 2 = incremental but useful; 3 = clear advance for the subfield; 4 = major advance likely to change practice or theory"
        },
        "basis": {
         "type": "string",
         "description": "which prior work or field knowledge the rating relies on; say so when it goes beyond the supplied materials"
        },
        "confidence": {
         "enum": [
          "low",
          "medium",
          "high"
         ]
        }
       }
      }
     }
    },
    "overall_assessment": {
     "type": "string",
     "description": "<=150 words"
    }
   }
  },
  "T2": {
   "type": "object",
   "properties": {
    "adequacy_label": {
     "type": "string",
     "enum": [
      "sufficient",
      "partially_sufficient",
      "insufficient",
      "insufficient_evidence"
     ]
    },
    "addressed_requirements": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "remaining_gaps": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "evidence_refs": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "input_field": {
        "type": "string"
       },
       "exact_quote": {
        "type": "string"
       },
       "location_hint": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "input_field",
       "exact_quote",
       "location_hint"
      ],
      "additionalProperties": false
     }
    },
    "rationale": {
     "type": "string"
    },
    "revision_verification": {
     "const": "not_assessed"
    }
   },
   "required": [
    "adequacy_label",
    "addressed_requirements",
    "remaining_gaps",
    "evidence_refs",
    "rationale",
    "revision_verification"
   ],
   "additionalProperties": false,
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "title": "T2_response_v0.2 (unchanged from v0.1)"
  },
  "T3": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "overall_label",
    "rationale",
    "issues",
    "evidence_limits"
   ],
   "properties": {
    "overall_label": {
     "type": "string",
     "enum": [
      "acceptable_under_rubric",
      "needs_substantive_revision",
      "insufficient_evidence"
     ]
    },
    "rationale": {
     "type": "string"
    },
    "issues": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "issue",
       "response_claim",
       "observed_change",
       "resolution",
       "importance",
       "evidence",
       "issue_type"
      ],
      "properties": {
       "issue": {
        "type": "string"
       },
       "response_claim": {
        "type": "string"
       },
       "observed_change": {
        "type": "string"
       },
       "resolution": {
        "type": "string",
        "enum": [
         "resolved",
         "partially_resolved",
         "unresolved",
         "not_verifiable",
         "reviewer_request_not_warranted"
        ]
       },
       "importance": {
        "type": "string",
        "enum": [
         "central",
         "supporting",
         "minor"
        ]
       },
       "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
         "oneOf": [
          {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "input_field",
            "exact_quote",
            "location_hint"
           ],
           "properties": {
            "input_field": {
             "type": "string"
            },
            "exact_quote": {
             "type": "string"
            },
            "location_hint": {
             "type": "string"
            }
           }
          },
          {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "input_field",
            "page",
            "observation"
           ],
           "properties": {
            "input_field": {
             "const": "page_images"
            },
            "page": {
             "type": "integer",
             "minimum": 1
            },
            "observation": {
             "type": "string",
             "minLength": 1
            }
           }
          }
         ]
        }
       },
       "issue_type": {
        "enum": [
         "V1",
         "V2",
         "V3",
         "V4",
         "V5",
         "V6",
         "V7",
         "V8",
         "V9"
        ]
       }
      }
     }
    },
    "evidence_limits": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "process_consistency_auxiliary": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "title": "T3_revision_v0.2"
  }
 },
 "contribution_codes": {
  "C1": "识别声称的贡献",
  "C2": "贡献声称是否有稿件内依据",
  "C3": "贡献与证据相称",
  "C4": "外部新颖性与重要性（仅 C4 子集计分）"
 }
}